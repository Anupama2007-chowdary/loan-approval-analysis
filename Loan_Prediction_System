        "# ============================================================\n",
        "# LOAN PREDICTION ANALYSIS SYSTEM\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "# 1. LOAD DATASET\n",
        "df = pd.read_csv(\"loan_approval_dataset.csv\")\n",
        "\n",
        "# 2. CLEAN DATA\n",
        "df.columns = df.columns.str.strip().str.lower()\n",
        "\n",
        "for col in df.select_dtypes(include=\"object\").columns:\n",
        "    df[col] = df[col].str.strip()\n",
        "\n",
        "# 3. DATASET OVERVIEW\n",
        "print(\"\\n\" + \"=\" * 45)\n",
        "print(\"       LOAN PREDICTION ANALYSIS SYSTEM\")\n",
        "print(\"=\" * 45)\n",
        "\n",
        "print(\"\\n========== DATASET OVERVIEW ==========\")\n",
        "print(\"Total Applicants:\", len(df))\n",
        "print(\"Total Attributes:\", len(df.columns))\n",
        "print(\"Loan ID Range:\", df[\"loan_id\"].min(), \"to\", df[\"loan_id\"].max())\n",
        "print(\"Approved Loans:\",\n",
        "      (df[\"loan_status\"].str.lower() == \"approved\").sum())\n",
        "print(\"Rejected Loans:\",\n",
        "      (df[\"loan_status\"].str.lower() == \"rejected\").sum())\n",
        "print(\"Assessment Factors: 7\")\n",
        "print(\"Prediction Method: Rule-Based Assessment\")\n",
        "print(\"=\" * 45)\n",
        "\n",
        "# 4. ENTER APPLICANT ID\n",
        "loan_id = input(\"\\nEnter Applicant ID: \").strip()\n",
        "\n",
        "applicant = df[df[\"loan_id\"].astype(str) == loan_id]\n",
        "\n",
        "if applicant.empty:\n",
        "    print(\"\\nApplicant ID not found. Please enter a valid ID.\")\n",
        "\n",
        "else:\n",
        "    a = applicant.iloc[0]\n",
        "\n",
        "    # 5. DISPLAY APPLICANT DETAILS\n",
        "    print(\"\\n========== APPLICANT DETAILS ==========\")\n",
        "    print(\"Applicant ID:\", a[\"loan_id\"])\n",
        "    print(\"CIBIL Score:\", a[\"cibil_score\"])\n",
        "    print(\"Annual Income: ₹\", f\"{a['income_annum']:,.0f}\")\n",
        "    print(\"Loan Amount: ₹\", f\"{a['loan_amount']:,.0f}\")\n",
        "    print(\"Loan Term:\", a[\"loan_term\"], \"years\")\n",
        "    print(\"Education:\", a[\"education\"])\n",
        "    print(\"Self Employed:\", a[\"self_employed\"])\n",
        "    print(\"Dependents:\", a[\"no_of_dependents\"])\n",
        "\n",
        "    # 6. SEVEN-FACTOR LOAN ASSESSMENT\n",
        "    score = 0\n",
        "\n",
        "    # Factor 1: CIBIL Score (30 points)\n",
        "    if a[\"cibil_score\"] >= 750:\n",
        "        score += 30\n",
        "    elif a[\"cibil_score\"] >= 700:\n",
        "        score += 25\n",
        "    elif a[\"cibil_score\"] >= 650:\n",
        "        score += 15\n",
        "\n",
        "    # Factor 2: Annual Income (15 points)\n",
        "    if a[\"income_annum\"] >= 1000000:\n",
        "        score += 15\n",
        "    elif a[\"income_annum\"] >= 500000:\n",
        "        score += 10\n",
        "    elif a[\"income_annum\"] >= 200000:\n",
        "        score += 5\n",
        "\n",
        "    # Factor 3: Loan Amount vs Annual Income (15 points)\n",
        "    if a[\"income_annum\"] > 0:\n",
        "        ratio = a[\"loan_amount\"] / a[\"income_annum\"]\n",
        "\n",
        "        if ratio <= 2:\n",
        "            score += 15\n",
        "        elif ratio <= 4:\n",
        "            score += 10\n",
        "        elif ratio <= 5:\n",
        "            score += 5\n",
        "\n",
        "    # Factor 4: Loan Term (10 points)\n",
        "    if a[\"loan_term\"] >= 10:\n",
        "        score += 10\n",
        "    elif a[\"loan_term\"] >= 5:\n",
        "        score += 5\n",
        "\n",
        "    # Factor 5: Education (10 points)\n",
        "    if a[\"education\"].lower() == \"graduate\":\n",
        "        score += 10\n",
        "\n",
        "    # Factor 6: Employment Status (10 points)\n",
        "    if a[\"self_employed\"].lower() == \"no\":\n",
