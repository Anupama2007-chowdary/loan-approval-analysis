        "\n",
        "# MODULE 6: RULE-BASED LOAN ASSESSMENT AND EVALUATION\n",
        "\n",
        "# 1. Import required libraries\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "\n",
        "# 2. Prepare the dataset\n",
        "data = df.copy()\n",
        "\n",
        "# Clean column names and remove unwanted spaces\n",
        "data.columns = data.columns.str.strip().str.lower().str.replace(\" \", \"_\")\n",
        "\n",
        "for col in data.select_dtypes(include=\"object\").columns:\n",
        "    data[col] = data[col].str.strip()\n",
        "\n",
        "# Check whether all required columns are available\n",
        "required = [\n",
        "    \"loan_id\", \"no_of_dependents\", \"education\", \"self_employed\",\n",
        "    \"income_annum\", \"loan_amount\", \"loan_term\", \"cibil_score\",\n",
        "    \"residential_assets_value\", \"commercial_assets_value\",\n",
        "    \"luxury_assets_value\", \"bank_asset_value\", \"loan_status\"\n",
        "]\n",
        "\n",
        "for col in required:\n",
        "    if col not in data.columns:\n",
        "        raise ValueError(\"Missing column: \" + col)\n",
        "\n",
        "print(\"Dataset prepared successfully!\")\n",
        "print(\"Total records:\", len(data))\n",
        "\n",
        "\n",
        "# 3. Function to validate numeric inputs\n",
        "def get_number(message, minimum=None, maximum=None, integer=False):\n",
        "\n",
        "    while True:\n",
        "        try:\n",
        "            value = float(input(message))\n",
        "\n",
        "            # Check whether the input is a whole number\n",
        "            if integer and not value.is_integer():\n",
        "                print(\"Please enter a whole number.\")\n",
        "                continue\n",
        "\n",
        "            # Check minimum and maximum limits\n",
        "            if minimum is not None and value < minimum:\n",
        "                print(\"Value must be at least\", minimum)\n",
        "                continue\n",
        "\n",
        "            if maximum is not None and value > maximum:\n",
        "                print(\"Value cannot exceed\", maximum)\n",
        "                continue\n",
        "\n",
        "            return int(value) if integer else value\n",
        "\n",
        "        except ValueError:\n",
        "            print(\"Invalid input! Please enter a number.\")\n",
        "\n",
        "\n",
        "# 4. Function to validate text inputs\n",
        "def get_choice(message, choices):\n",
        "\n",
        "    while True:\n",
        "        value = input(message).strip().title()\n",
        "\n",
        "        if value in choices:\n",
        "            return value\n",
        "\n",
        "        print(\"Invalid input! Choose:\", \" or \".join(choices))\n",
        "\n",
        "\n",
        "# 5. Rule-based loan assessment function\n",
        "def assess_loan(a):\n",
        "\n",
        "    income = float(a[\"income_annum\"])\n",
        "    amount = float(a[\"loan_amount\"])\n",
        "    term = float(a[\"loan_term\"])\n",
        "    cibil = float(a[\"cibil_score\"])\n",
        "    dependents = int(a[\"no_of_dependents\"])\n",
        "\n",
        "    residential = float(a[\"residential_assets_value\"])\n",
        "    commercial = float(a[\"commercial_assets_value\"])\n",
        "    luxury = float(a[\"luxury_assets_value\"])\n",
        "    bank = float(a[\"bank_asset_value\"])\n",
        "\n",
        "\n",
        "    # 6. Evaluate CIBIL score (Maximum 30 points)\n",
        "    if cibil >= 750:\n",
        "        cibil_points = 30\n",
        "    elif cibil >= 700:\n",
        "        cibil_points = 24\n",
        "    elif cibil >= 650:\n",
        "        cibil_points = 15\n",
        "    else:\n",
        "        cibil_points = 0\n",
        "\n",
        "\n",
        "    # 7. Evaluate repayment affordability (Maximum 25 points)\n",
        "    annual_repayment = amount / term\n",
        "    repayment_ratio = annual_repayment / income\n",
        "\n",
        "    if repayment_ratio <= 0.20:\n",
        "        repayment_points = 25\n",
        "    elif repayment_ratio <= 0.40:\n",
        "        repayment_points = 18\n",
        "    elif repayment_ratio <= 0.60:\n",
        "        repayment_points = 10\n",
        "    else:\n",
        "        repayment_points = 0\n",
        "\n",
        "\n",
        "    # 8. Evaluate total asset coverage (Maximum 20 points)\n",
        "    total_assets = residential + commercial + luxury + bank\n",
        "    asset_ratio = total_assets / amount\n",
        "\n",
        "    if asset_ratio >= 1:\n",
        "        asset_points = 20\n",
        "    elif asset_ratio >= 0.5:\n",
        "        asset_points = 12\n",
        "    else:\n",
        "        asset_points = 4\n",
        "\n",
        "\n",
        "    # 9. Evaluate household income (Maximum 15 points)\n",
        "    household_size = dependents + 1\n",
        "    income_per_member = income / household_size\n",
        "\n",
        "    if income_per_member >= 1000000:\n",
        "        household_points = 15\n",
        "    elif income_per_member >= 500000:\n",
        "        household_points = 10\n",
        "    elif income_per_member >= 250000:\n",
        "        household_points = 5\n",
        "    else:\n",
        "        household_points = 0\n",
        "\n",
        "\n",
        "    # 10. Evaluate bank assets (Maximum 10 points)\n",
        "    bank_ratio = bank / amount\n",
        "\n",
        "    if bank_ratio >= 0.25:\n",
        "        bank_points = 10\n",
        "    elif bank_ratio >= 0.10:\n",
        "        bank_points = 5\n",
        "    else:\n",
        "        bank_points = 0\n",
        "\n",
        "\n",
        "    # 11. Calculate total score\n",
        "    score = (\n",
        "        cibil_points + repayment_points + asset_points\n",
        "        + household_points + bank_points\n",
        "    )\n",
        "\n",
        "    # Decide whether the loan is approved or rejected\n",
        "    if score >= 60:\n",
        "        decision = \"APPROVED\"\n",
        "    else:\n",
        "        decision = \"REJECTED\"\n",
        "\n",
        "\n",
        "    # Prepare the evaluation report\n",
        "    report = pd.DataFrame({\n",
        "        \"Factor\": [\n",
        "            \"CIBIL Score\",\n",
        "            \"Repayment Affordability\",\n",
        "            \"Total Asset Coverage\",\n",
        "            \"Household Income\",\n",
        "            \"Bank Assets\"\n",
        "        ],\n",
        "        \"Points Earned\": [\n",
        "            cibil_points,\n",
        "            repayment_points,\n",
        "            asset_points,\n",
        "            household_points,\n",
        "            bank_points\n",
        "        ],\n",
        "        \"Maximum Points\": [30, 25, 20, 15, 10]\n",
        "    })\n",
        "\n",
        "    return score, decision, report\n",
        "\n",
        "\n",
        "# 12. Collect new applicant details with validation\n",
        "print(\"\\n========== NEW LOAN APPLICATION ==========\")\n",
        "\n",
        "applicant = {}\n",
        "\n",
        "applicant[\"no_of_dependents\"] = get_number(\n",
        "    \"Number of dependents: \", 0, integer=True\n",
        ")\n",
        "\n",
        "applicant[\"education\"] = get_choice(\n",
        "    \"Education (Graduate/Not Graduate): \",\n",
        "    [\"Graduate\", \"Not Graduate\"]\n",
        ")\n",
        "\n",
        "applicant[\"self_employed\"] = get_choice(\n",
        "    \"Self-employed (Yes/No): \",\n",
        "    [\"Yes\", \"No\"]\n",
        ")\n",
        "\n",
        "applicant[\"income_annum\"] = get_number(\n",
        "    \"Annual income (₹): \", 0.01\n",
        ")\n",
        "\n",
        "applicant[\"loan_amount\"] = get_number(\n",
        "    \"Loan amount (₹): \", 0.01\n",
        ")\n",
        "\n",
        "applicant[\"loan_term\"] = get_number(\n",
        "    \"Loan term (years): \", 0.01\n",
        ")\n",
        "\n",
        "applicant[\"cibil_score\"] = get_number(\n",
        "    \"CIBIL score (300-900): \", 300, 900\n",
        ")\n",
        "\n",
        "applicant[\"residential_assets_value\"] = get_number(\n",
        "    \"Residential assets (₹): \", 0\n",
        ")\n",
        "\n",
        "applicant[\"commercial_assets_value\"] = get_number(\n",
        "    \"Commercial assets (₹): \", 0\n",
        ")\n",
        "\n",
        "applicant[\"luxury_assets_value\"] = get_number(\n",
        "    \"Luxury assets (₹): \", 0\n",
        ")\n",
        "\n",
        "applicant[\"bank_asset_value\"] = get_number(\n",
        "    \"Bank assets (₹): \", 0\n",
        ")\n",
        "\n",
        "\n",
        "# 13. Evaluate the new applicant\n",
        "score, decision, report = assess_loan(applicant)\n",
        "\n",
        "\n",
        "# 14. Display the evaluation breakdown and final result\n",
        "print(\"\\n========== LOAN EVALUATION ==========\")\n",
        "\n",
        "# Display points earned for each factor\n",
        "display(report)\n",
        "\n",
        "# Display the total score\n",
        "print(\"Total Score:\", score, \"/ 100\")\n",
        "\n",
        "# Display the final decision\n",
        "print(\"\\n========== FINAL LOAN RESULT ==========\")\n",
        "print(decision)\n",
        "\n",
        "\n",
        "# 15. Compare results with historical loan records\n",
        "actual = []\n",
        "predicted = []\n",
        "\n",
        "for _, row in data.iterrows():\n",
        "\n",
        "    try:\n",
        "        score, decision, report = assess_loan(row)\n",
        "\n",
        "        predicted.append(decision.title())\n",
        "        actual.append(str(row[\"loan_status\"]).strip().title())\n",
        "\n",
        "    except (ValueError, TypeError, KeyError):\n",
        "        continue\n",
        "\n",
        "\n",
        "# 16. Display historical evaluation results\n",
        "comparison = pd.DataFrame({\n",
        "    \"Actual Status\": actual,\n",
        "    \"Rule-Based Result\": predicted\n",
        "})\n",
        "\n",
        "if len(comparison) > 0:\n",
        "\n",
        "    # Calculate historical agreement percentage\n",
        "    agreement = (\n",
        "        comparison[\"Actual Status\"] == comparison[\"Rule-Based Result\"]\n",
        "    ).mean() * 100\n",
        "\n",
        "    print(\"\\n========== HISTORICAL EVALUATION ==========\")\n",
        "    print(\"Records Compared:\", len(comparison))\n",
        "    print(f\"Historical Agreement: {agreement:.2f}%\")\n",
        "\n",
        "    # Compare actual and rule-based decisions\n",
        "    result_table = pd.crosstab(\n",
        "        comparison[\"Actual Status\"],\n",
        "        comparison[\"Rule-Based Result\"]\n",
        "    )\n",
        "\n",
        "    display(result_table)\n",
        "\n",
        "\n",
        "    # 17. Display a heatmap of historical results\n",
        "    sns.heatmap(result_table, annot=True, fmt=\"d\", cmap=\"Blues\")\n",
        "\n",
